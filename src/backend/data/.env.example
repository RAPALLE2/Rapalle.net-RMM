# ============================================================
# RAPALLE.net RMM - Backend Konfiguration
# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# ============================================================

# Port, auf dem das Backend erreichbar ist
PORT=4000

# Bind-Adresse des Backends. LEER LASSEN = automatisch die lokale LAN-IP
# dieses Rechners verwenden (empfohlen beim frischen Install).
# Beispiele: HOST=192.168.1.50  oder  HOST=0.0.0.0 (alle Interfaces)
HOST=

# Geheimer Schlüssel, den JEDER Agent kennen muss, um sich zu verbinden.
# WICHTIG: Ändere diesen Wert auf etwas Langes/Zufälliges!
AGENT_TOKEN=change-me-super-secret

# Geheimer Schlüssel zum Signieren der Login-Tokens (JWT).
# WICHTIG: Auch diesen Wert unbedingt ändern!
JWT_SECRET=change-me-jwt-secret

# Von wo aus darf das Frontend auf das Backend zugreifen (CORS).
# Bei lokalem Betrieb über die Backend-eigene Auslieferung meist unverändert lassen.
CORS_ORIGIN=*
