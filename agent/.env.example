# ============================================================
# RAPALLE.net RMM - Agent Konfiguration
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# ============================================================

# Adresse deines Backend-Servers (der Rechner, auf dem "backend" läuft)
BACKEND_URL=http://192.168.1.10:4000

# Muss EXAKT mit AGENT_TOKEN in backend/.env übereinstimmen
AGENT_TOKEN=change-me-super-secret

# Optional: wird beim "Client hinzufügen"-Assistenten automatisch eingetragen,
# ordnet diesen Agenten beim ersten Verbinden automatisch dem richtigen
# Tenant/Standort zu. Kann leer bleiben, wenn du manuell zuordnen willst.
ENROLLMENT_TOKEN=

# Optional: fester Anzeigename für dieses Gerät (sonst wird der Hostname genutzt)
DEVICE_NAME=

# Sprache der Dialoge AM GERÄT (Zustimmung zum Remote-Bildschirm): de oder en.
# Das ist NICHT die Dashboard-Sprache - den Dialog sieht die Person, die vor
# dem Gerät sitzt, und mehrere Dashboard-Benutzer mit unterschiedlichen
# Spracheinstellungen können dasselbe Gerät ansehen.
AGENT_LANG=de
