# ─────────────────────────────────────────────────────────────────────────────
# Einstellungen für "docker compose" (diese Datei nach ".env" kopieren).
# Betrifft NUR den Container-Betrieb. Beim nativen Betrieb ist backend/.env
# zuständig.
#
#   cp .env.example .env
#   docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Port im Browser UND im Container. Nach einer Änderung ist ein
# "docker compose up -d" nötig - in der laufenden Instanz lässt sich der
# Port nicht mehr umstellen.
RMM_PORT=4000

# Zeitzone des Containers (Logs, Audit, Zeitpläne).
TZ=Europe/Berlin

# Projektname - bestimmt die Container-Namen bei mehreren Instanzen.
COMPOSE_PROJECT_NAME=rapalle-rmm

# ── Leistung ───────────────────────────────────────────────────────────────
# Obergrenzen, KEINE Zuteilung: Ohne diese Zeilen darf der Container alles
# nutzen, was der Host hergibt. Ist das Dashboard zäh, zuerst prüfen, ob die
# Container-Oberfläche der NAS eigene, engere Grenzen gesetzt hat.
RMM_CPUS=4
RMM_MEMORY=4g
RMM_MEMORY_MIN=512m
RMM_SHM=512m

# guacd macht die Bildarbeit bei RDP/VNC - bei ruckelnden Sitzungen hier erhöhen.
GUACD_CPUS=2
GUACD_MEMORY=1g

# ----------------------------------------------------------------------
# Aufnahme-Schleuse für Agenten ("einer nach dem anderen")
# ----------------------------------------------------------------------
# Nach einem Neustart wollen alle Agenten gleichzeitig verbinden. Jede
# Anmeldung kostet Datenbank-Schreibvorgänge und Broadcasts an alle
# Dashboards - gleichzeitig ausgeführt bringt das den Container zum
# Absturz. Diese Werte begrenzen, wie viel davon parallel passiert.

# Wie viele Agenten dürfen sich GLEICHZEITIG anmelden? 1 = strikt nacheinander.
AGENT_ADMISSION_SLOTS=1
# Wie lange (Sekunden) wartet ein Agent auf seinen Platz, bevor er abgewiesen
# wird (er versucht es danach von selbst erneut)?
AGENT_ADMISSION_WAIT_S=25
# Wie viele Agenten dürfen höchstens gleichzeitig in der Warteschlange stehen?
AGENT_ADMISSION_QUEUE=100
# Notbremse: Meldet sich ein verbundener Agent nicht binnen dieser Zeit an,
# wird sein Platz freigegeben, damit die Schleuse nicht blockiert.
AGENT_ADMISSION_HOLD_S=30
# Wie viele Heartbeats werden gleichzeitig verarbeitet?
AGENT_HEARTBEAT_SLOTS=4

# ----------------------------------------------------------------------
# VPN (WireGuard-kompatibel)
# ----------------------------------------------------------------------
# UDP-Port, auf dem der Python-WireGuard-Endpunkt lauscht. Muss in der
# Firewall offen sein; die Freigabe im Container erledigt docker-compose.
VPN_PORT=51820

# ----------------------------------------------------------------------
# Wartungsmodus / Diagnose
# ----------------------------------------------------------------------
# Ablage der Diagnose-Logs. Standard ist backend/logs - das liegt im
# Bind-Mount und ueberlebt damit einen Container-Neustart, was bei der
# Absturzsuche der springende Punkt ist.
# RMM_LOG_DIR=/app/backend/logs

# Gestaffeltes Agent-Massenupdate. Alle Agenten gleichzeitig zu aktualisieren
# erzeugt eine Welle aus Downloads, Verbindungsabbruechen und Anmeldungen -
# genau das hat den Healthcheck und Cloudflare in ihre Zeitlimits laufen
# lassen. Hier laesst sich das Tempo anpassen.
AGENT_UPDATE_BATCH=2
AGENT_UPDATE_PAUSE_S=20

# ----------------------------------------------------------------------
# Selbstheilung und Wächter
# ----------------------------------------------------------------------
# Ab wie vielen Sekunden stehender Ereignisschleife sich das Backend selbst
# beendet, damit es neu gestartet wird. Docker startet einen Container NICHT
# wegen eines fehlgeschlagenen Healthchecks neu - nur wenn er sich beendet.
# Deshalb ist diese kontrollierte Selbstbeendigung nötig. 0 schaltet sie ab.
RMM_LOOP_KILL_S=90
# Dasselbe im Agenten (er startet sich dabei neu, statt sich zu beenden).
AGENT_LOOP_KILL_S=120
# Ab dieser Dauer gilt eine HTTP-Anfrage bzw. eine Datenbankabfrage als
# auffällig langsam und wird protokolliert. Das sind die Kandidaten, die
# den Server blockieren.
RMM_SLOW_REQUEST_S=2.0
RMM_SLOW_QUERY_S=0.5
# Wie lange die Notfall-Fehlerseite erreichbar bleibt, bevor der Container
# endet und neu startet. 0 = ohne Ende (nur zur Fehlersuche).
RMM_DIAG_SECONDS=180
# Wie oft Startweg 1 (run.py) nach einem schnellen Fehlstart wiederholt wird,
# bevor die schwächeren Startwege probiert werden.
RMM_MAX_QUICK_RESTARTS=20

# Hinweis zum Threadpool: Seit die meisten Endpunkte synchron sind (siehe
# tools/unblock_routes.py), laufen sie in Arbeits-Threads. Deren Anzahl gibt
# Starlette vor (40). In der Diagnose zeigt "Anfragen in Arbeit", wie viele
# davon belegt sind - steht der Wert dauerhaft nahe 40, warten Anfragen.

# ----------------------------------------------------------------------
# Fehlerbehandlung und Datenbank-Notbremse
# ----------------------------------------------------------------------
# Nach dieser Zeit wird eine laufende Datenbankabfrage ABGEBROCHEN. Grund:
# Alle Abfragen gehen durch dieselbe Sperre - eine einzige lange Abfrage
# legt sonst das ganze Backend still. Genau das ist am 23.08. passiert
# (Metrikverlauf, 125 Sekunden). 0 schaltet die Notbremse ab.
RMM_QUERY_DEADLINE_S=20
# Abstand der Zustandszeilen in der Container-Ausgabe ("docker logs").
# Sie sind das Einzige, was einen Absturz sicher ueberlebt.
RMM_BEAT_INTERVAL_S=60
# Wie lange auf die Datenbanksperre gewartet wird, bevor ein Aufruf mit
# Fehler abbricht. Verhindert, dass ein haengendes commit() (z.B. bei
# gesaettigter Platte) den ganzen Server anhaelt.
RMM_DB_LOCK_TIMEOUT_S=30
